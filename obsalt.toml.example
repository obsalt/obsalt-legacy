# obsalt.toml — copy to obsalt.toml (gitignored) or pass --config.
# Environment variables (OBSALT_*) always override these values.
# Secrets can live here, but .env is the better place for them.

[server]
host = "0.0.0.0"
port = 8080

[auth]
# org:secret pairs. Send the secret as X-API-Key or Authorization: Bearer.
api_keys = "acme:change-me"
require_auth = false

[export]
# OTLP HTTP base. obsalt appends /v1/traces and /v1/metrics.
# Grafana LGTM: docker run --rm -p 3000:3000 -p 4318:4318 grafana/otel-lgtm
otlp_endpoint = "http://localhost:4318"
environment = "dev"
service_name = "obsalt"

[webhooks]
# Empty = skip provider signature checks (local only).
vapi_secret = ""
retell_secret = ""
bland_secret = ""
