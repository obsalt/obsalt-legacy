# Copy to .env — obsalt loads this file from the working directory.
# Do not commit .env. obsalt.toml.example is the checked-in companion.

OBSALT_API_KEYS=acme:change-me
OBSALT_REQUIRE_AUTH=false
OBSALT_OTLP_ENDPOINT=http://localhost:4318
